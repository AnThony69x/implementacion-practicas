          "raw": "{\n  \"clienteId\": \"1\",\n  \"metodoPago\": \"Tarjeta\",\n  \"fechaEntrega\": \"20/11/2026\",\n  \"detalle\": [\n    {\n      \"productoId\": \"3\",\n      \"cantidad\": \"2.5\"\n    }\n  ]\n}",
          "options": {

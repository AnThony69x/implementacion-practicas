          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-Correlation-ID",
            "value": "p32-caso2"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 102,\n  \"tipo\": \"pago_registrado\",\n  \"prioridad\": \"media\",\n  \"estado\": \"activo\",\n  \"datos\": {\n    \"pedido_id\": 88,\n    \"monto\": 35.5\n  }\n}"
        },
        "url": "{{base_url}}/api/v1/laboratorio/enrutamiento/mensajes"
      }
    },

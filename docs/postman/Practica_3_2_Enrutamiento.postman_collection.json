{
  "info": {
    "name": "Practica 3.2 - Enrutamiento (CBR + Message Filter)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "Caso 1 - pedido_creado -> produccion",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-Correlation-ID",
            "value": "p32-caso1"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 101,\n  \"tipo\": \"pedido_creado\",\n  \"prioridad\": \"alta\",\n  \"estado\": \"activo\",\n  \"datos\": {\n    \"pedido_id\": 88,\n    \"producto\": \"Torta de chocolate\"\n  }\n}"
        },
        "url": "{{base_url}}/api/v1/laboratorio/enrutamiento/mensajes"
      }
    },
    {
      "name": "Caso 2 - pago_registrado -> pagos",

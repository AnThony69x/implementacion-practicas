{
  "info": {
    "name": "Practica 2.4 - Seguridad",
    "description": "Entorno local: API en http://127.0.0.1:8000 (BD local de prueba). Tokens e ids se guardan solos. Ejecuta Preparacion y luego Pruebas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://127.0.0.1:8000/api/v1"
    },
    {
      "key": "admin_correo",
      "value": "admin24@prueba.test"
    },
    {
      "key": "admin_password",
      "value": "Prueba2026!"
    },
    {
      "key": "cliente_correo",
      "value": "cliente24@prueba.test"
    },
    {
      "key": "cliente_password",
      "value": "Prueba2026!"
    },
    {
      "key": "token_admin",
      "value": ""
    },
    {
      "key": "token_cliente",
      "value": ""
    },
    {
      "key": "admin_id",
      "value": ""
    },
    {
      "key": "cliente_id",
      "value": ""
    },
    {
      "key": "pedido_propio",
      "value": ""
    },
    {
      "key": "pedido_ajeno",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Preparacion",
      "item": [
        {
          "name": "Login ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{admin_correo}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set(\"token_admin\", j.data.token);",
                  "pm.collectionVariables.set(\"admin_id\", j.data.usuario.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login CLIENTE",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{cliente_correo}}\",\n  \"password\": \"{{cliente_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set(\"token_cliente\", j.data.token);",
                  "pm.collectionVariables.set(\"cliente_id\", j.data.usuario.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar pedido propio PENDIENTE (CLIENTE)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_cliente}}"
              }
            ],
            "url": "{{base}}/pedidos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const l = pm.response.json().data || [];",
                  "const p = l.find(x => x.estado === \"PENDIENTE\");",
                  "if (!p) console.warn(\"Sin pedidos PENDIENTE: vuelve a ejecutar el seeder Practica24Seeder\");",
                  "else pm.collectionVariables.set(\"pedido_propio\", p.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar pedido ajeno (ADMIN)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": "{{base}}/admin/pedidos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const l = pm.response.json().data || [];",
                  "const o = l.find(p => String(p.usuario_id) !== pm.collectionVariables.get(\"cliente_id\"));",
                  "if (!o) console.warn(\"No hay pedidos de otro usuario: crea uno con otra cuenta\");",
                  "else pm.collectionVariables.set(\"pedido_ajeno\", o.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Pruebas",
      "item": [
        {
          "name": "P1 CLIENTE pedido propio -> 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_cliente}}"
              }
            ],
            "url": "{{base}}/pedidos/{{pedido_propio}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"P1 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "P1b ADMIN cancela pedido (PENDIENTE->CANCELADO) -> 200",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/admin/pedidos/{{pedido_propio}}/estado",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"CANCELADO\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"P1b 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "P2 sin token -> 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/pedidos/{{pedido_propio}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"P2 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "P3 CLIENTE en ruta admin -> 403",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_cliente}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/admin/pedidos/{{pedido_propio}}/estado",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"CANCELADO\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"P3 403 AUTH_FORBIDDEN\", () => { pm.response.to.have.status(403); pm.expect(pm.response.json().codigo_error).to.eql(\"AUTH_FORBIDDEN\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "P3b CLIENTE pedido ajeno -> 403",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_cliente}}"
              }
            ],
            "url": "{{base}}/pedidos/{{pedido_ajeno}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"P3b 403 PED_AJENO\", () => { pm.response.to.have.status(403); pm.expect(pm.response.json().codigo_error).to.eql(\"PED_AJENO\"); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}